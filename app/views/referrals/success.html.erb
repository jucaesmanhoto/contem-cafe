<% content_for :title, "Seu link de indicação" %>

<div class="bg-white min-h-screen px-6 md:px-10 lg:px-12 py-12 max-w-2xl mx-auto">
  <%= link_to root_path do %>
    <div class="musa-wordmark mb-4">
      <span class="musa-wordmark-word">Musa</span>
      <span class="musa-wordmark-tag">Cafés que inspiram</span>
    </div>
  <% end %>
  <h1 class="text-3xl md:text-4xl font-serif text-stone-900 mb-2 leading-tight">Sua indicação está pronta!</h1>
  <p class="text-stone-500 mb-10">
    Compartilhe seu link: quem entrar pelo seu convite ganha desconto, e você ajuda a Musa a inspirar mais gente com os seus cafés especiais.
  </p>

  <section class="mb-10">
    <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-3 block">De onde vem essa indicação</span>
    <% if @referral.depth.zero? %>
      <p class="text-stone-600 leading-relaxed">Você é o início dessa jornada — ninguém veio antes de você.</p>
    <% else %>
      <p class="text-stone-600 leading-relaxed">
        Antes de você, essa indicação já passou por
        <span class="text-amber-700 font-bold"><%= @referral.depth %> <%= @referral.depth == 1 ? "pessoa" : "pessoas" %></span>.
      </p>
    <% end %>
  </section>

  <section class="border border-stone-200 rounded-xl p-6 md:p-8 mb-6" data-controller="copy-to-clipboard">
    <h2 class="text-xl font-serif text-stone-900 mb-4">Seu link de indicação e desconto</h2>

    <%# No mobile o campo e o botão empilham: lado a lado o input (min-width
        automático do <input>) empurrava o "Copiar" para fora do card. %>
    <div class="flex flex-col sm:flex-row gap-2">
      <input type="text" readonly value="<%= referral_url(@referral.token) %>" data-copy-to-clipboard-target="source" class="w-full min-w-0 sm:flex-1 rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-600 bg-stone-50">
      <button type="button" data-action="click->copy-to-clipboard#copy" class="musa-btn musa-btn-primary musa-btn-sm w-full sm:w-auto shrink-0">Copiar</button>
    </div>
    <p data-copy-to-clipboard-target="feedback" class="hidden mt-2 text-sm text-stone-600 [&.is-visible]:block"></p>

    <%= link_to "Compartilhar no WhatsApp", whatsapp_share_url(@referral), target: "_blank", rel: "noopener",
          class: "musa-btn musa-btn-secondary mt-4 w-full" %>
  </section>

  <%= link_to "Esqueci de pedir café... volta",
        :back,
        class: "musa-btn musa-btn-primary w-full" %>
</div>

<style>
  :root {
    --musa-cream:    #fdfaf6;
    --musa-bronze:   #8c6038;
    --musa-espresso: #281307;
    --musa-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  }

  .musa-wordmark { display: flex; flex-direction: column; align-items: flex-start; }
  .musa-wordmark-word {
    font-family: "Playfair Display", "Didot", "Bodoni 72", "Bodoni MT", "Hoefler Text", Georgia, serif;
    font-weight: 900;
    font-size: clamp(22px, 6vw, 40px);
    line-height: .95;
    letter-spacing: .01em;
    text-transform: uppercase;
    color: var(--musa-espresso);
  }
  .musa-wordmark-tag {
    margin-top: 4px;
    font-family: var(--musa-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--musa-bronze);
  }

  .musa-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--musa-sans);
    font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600;
    text-decoration: none; padding: 14px 26px; border-radius: 2px;
    /* rótulos longos quebram em linha: centralizar o texto também, senão a
       segunda linha fica encostada à esquerda */
    text-align: center; text-wrap: balance;
    transition: transform .2s, border-color .2s, background-color .2s, color .2s;
  }
  .musa-btn-primary { background: var(--musa-bronze); color: var(--musa-cream); border: 1px solid var(--musa-bronze); }
  .musa-btn-primary:hover { transform: translateY(-2px); }
  .musa-btn-secondary { background: transparent; color: var(--musa-bronze); border: 1px solid var(--musa-bronze); }
  .musa-btn-secondary:hover { background: var(--musa-bronze); color: var(--musa-cream); }
  .musa-btn-sm { padding: 10px 18px; }
  .musa-btn:focus-visible { outline: 2px solid var(--musa-bronze); outline-offset: 3px; }

  /* telas estreitas: menos respiro lateral e tracking, para o rótulo caber
     em uma linha só */
  @media (max-width: 480px) {
    .musa-btn { padding: 14px 14px; letter-spacing: .06em; }
    .musa-btn-sm { padding: 12px 14px; }
  }
</style>
