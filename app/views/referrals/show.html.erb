<% content_for :title, "Indicação Musa" %>

<div class="bg-white min-h-screen px-6 md:px-10 lg:px-12 py-12 max-w-5xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-start">
    <div>
      <div class="flex items-center justify-between gap-4 mb-4 overflow-hidden max-w-95">
        <%= image_tag "musa_emblem.png", alt: "Emblema Musa", class: "h-20 sm:h-20 md:h-28 w-auto shrink-0 object-contain" %>
        <%= image_tag "musa_wordmark.png", alt: "Musa logotipo", class: "h-20 sm:h-20 md:h-28 w-auto max-w-[65%] object-contain" %>
      </div>
      <h1 class="text-3xl md:text-4xl font-serif text-stone-900 mb-2 leading-tight">Você ganhou um desconto de <span class="text-amber-700 font-bold"><%= number_with_precision(@referral.discount_percentage, precision: 1, strip_insignificant_zeros: true, separator: ",") %>%</span> de presente!</h1>
      <p class="text-stone-500 mb-8">
        <strong class="text-stone-800"><%= @referral.name %></strong> presenteou você com uma chance de provar os cafés que vão te inspirar — e seguir compartilhando essa experiência com mais gente.
      </p>
      
      <p class="text-stone-500 mb-8">
        Pedindo pelo whatsapp você paga o preço com desconto no seu primeiro pacotinho de 250g.
      </p>


      <section>
        <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-3 block">De onde vem esse convite</span>
        <% if @referral.discount_capped? %>
          <p class="text-stone-600 leading-relaxed">
            <% if @referral.depth.zero? %>
              <strong class="text-stone-800"><%= @referral.name %></strong> foi quem começou tudo — ninguém veio antes.
            <% else %>
              Antes de chegar até <strong class="text-stone-800"><%= @referral.name %></strong>, esse convite passou por
              <span class="text-amber-700 font-bold"><%= @referral.depth %> <%= @referral.depth == 1 ? "pessoa" : "pessoas" %></span>.
            <% end %>
            Esse link já atingiu o desconto máximo. Se quiser enviar um novo descontro, entre em contato pelo whatApp.
          </p>
        <% elsif @referral.depth.zero? %>
          <p class="text-stone-600 leading-relaxed">
            <strong class="text-stone-800"><%= @referral.name %></strong> foi quem começou tudo — ninguém veio antes. Você está entrando bem no início dessa jornada Musa.
          </p>
        <% else %>
          <p class="text-stone-600 leading-relaxed">
            Antes de chegar até <strong class="text-stone-800"><%= @referral.name %></strong>, esse convite passou por
            <span class="text-amber-700 font-bold"><%= @referral.depth %> <%= @referral.depth == 1 ? "pessoa" : "pessoas" %></span>.
            Agora é a sua vez de inspirar alguém com um desconto de <span class="text-amber-700 font-bold"><%= number_with_precision(@referral.next_discount_percentage, precision: 1, strip_insignificant_zeros: true, separator: ",") %>%</span>.
          </p>
        <% end %>
      </section>
    </div>

    <section class="border border-stone-200 rounded-xl p-6 md:p-8"
        data-controller="whatsapp-order"
        data-whatsapp-order-number-value="<%= admin_whatsapp_number %>"
        data-whatsapp-order-referrer-name-value="<%= @referral.name %>">
      <h2 class="text-xl font-serif text-stone-900 mb-1">O que você quer fazer?</h2>
      <p class="text-sm text-stone-500 mb-6">
        <% if @referral.discount_capped? %>
          Escolha seu café e peça pelo WhatsApp.
        <% else %>
          Escolha seu café e peça pelo WhatsApp, ou gere seu próprio link pra que alguém receba seu presente: um desconto <strong>ainda maior</strong>!
        <% end %>
      </p>

      <% if @new_referral.errors.any? %>
        <div class="mb-4 text-sm text-red-700"><%= @new_referral.errors.full_messages.to_sentence %>.</div>
      <% end %>

      <%= form_with url: referrals_path, method: :post, local: true do %>
        <%= hidden_field_tag :referrer_token, @referral.token %>

        <div class="mb-4">
          <label class="block text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-2">Escolha seu café</label>
          <div class="space-y-2">
            <% @coffees.availables.each do |coffee| %>
              <div class="rounded-xl border border-stone-200 px-4 py-3 has-[:checked]:border-amber-700 has-[:checked]:bg-amber-50" data-controller="coffee-modal">
                <label class="flex items-center justify-between gap-3 text-sm text-stone-800 cursor-pointer">
                  <span class="flex items-center gap-3">
                    <%= radio_button_tag "coffee_id", coffee.id, false, class: "accent-amber-700",
                          data: { whatsapp_order_target: "coffee", coffee_name: coffee.name,
                                  coffee_discounted_price: coffee_discounted_price_label(coffee, @referral.discount_percentage) } %>
                    <span><%= coffee.name %></span>
                    <button type="button" data-action="click->coffee-modal#open" class="text-xs text-stone-400 underline underline-offset-2 hover:text-amber-700">Ver café</button>
                  </span>

                  <% if coffee_price_label(coffee) %>
                    <span class="text-right leading-tight">
                      <span class="block text-xs text-stone-400 line-through"><%= coffee_price_label(coffee) %></span>
                      <span class="block text-amber-700 font-bold"><%= coffee_discounted_price_label(coffee, @referral.discount_percentage) %></span>
                    </span>
                  <% else %>
                    <span class="text-xs text-stone-400 italic"><%= coffee.stock_status.presence || "Esgotado" %></span>
                  <% end %>
                </label>

                <dialog data-coffee-modal-target="dialog" class="rounded-xl p-0 max-w-md w-[90vw] backdrop:bg-black/40">
                  <div class="p-6">
                    <% if coffee.photo.attached? %>
                      <%= image_tag coffee.photo, class: "w-full h-48 object-cover rounded-lg mb-4" %>
                    <% end %>
                    <h3 class="text-xl font-serif text-stone-900 mb-1"><%= coffee.name %></h3>
                    <p class="text-sm text-amber-700 font-medium mb-3"><%= coffee.variety %></p>
                    <% if coffee.description.present? %>
                      <p class="text-sm text-stone-600 mb-4"><%= coffee.description %></p>
                    <% end %>
                    <dl class="grid grid-cols-2 gap-3 text-xs text-stone-500 mb-6">
                      <div>
                        <dt class="uppercase tracking-widest font-bold mb-1">Processo</dt>
                        <dd><%= coffee.processing %></dd>
                      </div>
                      <div>
                        <dt class="uppercase tracking-widest font-bold mb-1">Altitude</dt>
                        <dd><%= coffee.altitude %>m</dd>
                      </div>
                    </dl>
                    <button type="button" data-action="click->coffee-modal#close" class="musa-btn musa-btn-secondary w-full">Fechar</button>
                  </div>
                </dialog>
              </div>
            <% end %>
          </div>
        </div>

        <div class="mb-4">
          <label class="block text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-2">Seu nome</label>
          <%= text_field_tag :name, params[:name], required: true, data: { whatsapp_order_target: "name" }, class: "w-full rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-700" %>
        </div>

        <div class="mb-4">
          <label class="block text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-2">Seu telefone (WhatsApp)</label>
          <%= text_field_tag :phone, params[:phone], required: true,
                data: { whatsapp_order_target: "phone", controller: "phone-mask", action: "input->phone-mask#format" },
                inputmode: "numeric", placeholder: "(11) 91234-5678", maxlength: 15,
                pattern: '\(\d{2}\) 9\d{4}-\d{4}',
                title: "Informe um número de celular com DDD, assim: (11) 91234-5678",
                class: "w-full rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-700" %>
        </div>

        <div class="mb-6">
          <label class="block text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-2">Observações (opcional)</label>
          <%= text_area_tag :details, nil, rows: 3, data: { whatsapp_order_target: "details" }, class: "w-full rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-700" %>
        </div>

        <div class="flex flex-col gap-3">
          <button type="button" data-action="click->whatsapp-order#send" class="musa-btn musa-btn-primary w-full">Pedir pelo WhatsApp</button>
          <% unless @referral.discount_capped? %>
            <%= submit_tag "Gerar desconto", class: "musa-btn musa-btn-secondary cursor-pointer w-full w-auto" %>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>

<style>
  :root {
    --musa-cream:    #fdfaf6;
    --musa-bronze:   #8c6038;
    --musa-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  }

  .musa-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--musa-sans);
    font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600;
    text-decoration: none; padding: 14px 26px; border-radius: 2px;
    /* rótulos longos quebram em linha: centralizar o texto também, senão a
       segunda linha fica encostada à esquerda */
    text-align: center; text-wrap: balance;
    transition: transform .2s, border-color .2s, background-color .2s, color .2s;
  }
  .musa-btn-primary { background: var(--musa-bronze); color: var(--musa-cream); border: 1px solid var(--musa-bronze); }
  .musa-btn-primary:hover { transform: translateY(-2px); }
  .musa-btn-secondary { background: transparent; color: var(--musa-bronze); border: 1px solid var(--musa-bronze); }
  .musa-btn-secondary:hover { background: var(--musa-bronze); color: var(--musa-cream); }
  .musa-btn:focus-visible { outline: 2px solid var(--musa-bronze); outline-offset: 3px; }

  dialog { border: none; box-shadow: 0 20px 50px rgba(0, 0, 0, .25); }
  dialog::backdrop { background: rgba(0, 0, 0, .4); }
</style>
