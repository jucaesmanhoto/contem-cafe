<div class="musa-farms-grid">
  <% farms.each do |farm| %>
    <% esgotado = farm.coffees.none? { |coffee| coffee.price.present? } %>
    <%= link_to farm_path(farm), class: "musa-farm-card#{' is-esgotado' if esgotado}" do %>

      <span class="musa-farm-photo<%= ' musa-farm-photo-empty' unless farm.photo.attached? %>">
        <% if farm.photo.attached? %>
          <%= image_tag farm.photo, alt: farm.name %>
        <% else %>
          <span class="musa-farm-empty-mark">Foto em breve</span>
        <% end %>
      </span>

      <span class="musa-farm-entry">
        <% if farm.region.present? %>
          <span class="musa-rail-label musa-rail-sm"><%= farm.region %></span>
        <% end %>

        <span class="musa-farm-name"><%= farm.name %></span>
        <span class="musa-farm-rule"></span>

        <% if farm.farmer.present? %>
          <span class="musa-farm-meta">
            <span class="musa-farm-k">Produtor</span>
            <span class="musa-farm-v"><%= farm.farmer %></span>
          </span>
        <% end %>

        <% if farm.city.present? %>
          <span class="musa-farm-meta">
            <span class="musa-farm-k">Cidade</span>
            <span class="musa-farm-v"><%= [farm.city, farm.state.presence].compact.join(" · ") %></span>
          </span>
        <% end %>

        <% if esgotado %>
          <span class="musa-farm-meta">
            <span class="musa-farm-k">Estoque</span>
            <span class="musa-farm-v"><span class="musa-chip">Esgotado</span></span>
          </span>
        <% end %>

        <span class="musa-farm-go">Ver fazenda <span class="musa-farm-arrow" aria-hidden="true">&rarr;</span></span>
      </span>

    <% end %>
  <% end %>
</div>
