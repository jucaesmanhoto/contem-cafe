<div class="bg-white min-h-screen px-6 md:px-10 lg:px-12 py-12 max-w-4xl mx-auto">
  <h1 class="text-3xl md:text-4xl font-serif text-stone-900 mb-8 leading-tight">
    Consultar torra
  </h1>
  <h3 class="text-md md:text-md font-serif text-stone-500 mb-8 leading-tight">
    Informe a data e o horário impressos na embalagem do seu café (ex.: 07.07 - 11:59)
  </h3>

  <%= form_with url: roasts_path, method: :get, class: "flex flex-col sm:flex-row gap-3 mb-10" do %>
    <input
      type="date"
      name="roast_date"
      value="<%= params[:roast_date] %>"
      required
      class="flex-1 rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-700"
    >
    <input
      type="time"
      name="roast_time"
      value="<%= params[:roast_time] %>"
      required
      class="flex-1 rounded-xl border border-stone-200 px-4 py-3 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-700"
    >
    <button type="submit" class="musa-btn musa-btn-primary">
      Buscar
    </button>
  <% end %>

  <% if @batch %>
    <div class="mb-8 pb-8 border-b border-stone-100">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-4 gap-x-4">
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1 block">Café</span>
          <%= link_to @batch.coffee.name, farm_coffee_path(@batch.coffee.farm, @batch.coffee), class: "block text-xl font-serif text-stone-900 mb-4" %>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Peso inicial</span>
          <span class="text-stone-800 font-medium text-sm"><%= @batch.initial_quantity_in_grams %>g</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Peso final</span>
          <span class="text-stone-800 font-medium text-sm"><%= @batch.final_quantity_in_grams %>g</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Perda de massa</span>
          <span class="text-stone-800 font-medium text-sm"><%= number_with_precision(100 * (1 - @batch.final_quantity_in_grams / @batch.initial_quantity_in_grams), precision: 2, separator: ",") %>%</span>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-4 gap-x-4">
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Batch</span>
          <span class="text-stone-800 font-medium text-sm"><%= @batch.batch_number %></span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Tempo total</span>
          <span class="text-stone-800 font-medium text-sm"><%= format_duration(@batch.total_time_in_seconds) %>s</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">1º Crack</span>
          <span class="text-stone-800 font-medium text-sm"><%= format_duration(@batch.first_crack_time_in_seconds) %>s / <%= @batch.first_crack_celsius_temperature %>°C</span>
        </div>
        <% if @batch.color_in_agtron %>
          <div class="flex flex-col">
            <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold mb-1">Agtron</span>
            <span class="text-stone-800 font-medium text-sm"><%= @batch.color_in_agtron %></span>
          </div>
        <% end %>
      </div>
    </div>

    <% if @batch_data.present? %>
      <div class="h-96">
        <canvas
          data-controller="roast-chart"
          data-roast-chart-points-value="<%= @batch_data.map { |datum|
            {
              time_in_seconds: datum.time_in_milliseconds / 1000.0,
              bean_temperature: datum.bean_temperature_in_celsius,
              exhaust_temperature: datum.exaust_temperature_in_celsius,
              ror: datum.ror
            }
          }.to_json %>"
          data-roast-chart-milestones-value="<%= {
            turningPoint: { time_in_seconds: @batch.turning_point_time_in_seconds, celsius_temperature: @batch.turning_point_celsius_temperature },
            dryEnd: { time_in_seconds: @batch.turn_to_yellow_time_in_seconds, celsius_temperature: @batch.turn_to_yellow_celsius_temperature },
            firstCrack: { time_in_seconds: @batch.first_crack_time_in_seconds, celsius_temperature: @batch.first_crack_celsius_temperature },
            drop: { time_in_seconds: @batch.total_time_in_seconds, celsius_temperature: nil }
          }.to_json %>"
        ></canvas>
      </div>
    <% else %>
      <p class="text-stone-500 text-sm">Nenhum dado de torra encontrado para este batch.</p>
    <% end %>
  <% end %>
</div>

<style>
:root {
    --musa-cream:      #fdfaf6;
    --musa-cream-deep: #f4ead9;
    --musa-bronze:     #8c6038;  /* ACENTO único: rótulos, filetes, links */
    --musa-bronze-soft:#b08d57;
    --musa-brown:      #3b2a1e;  /* corpo */
    --musa-espresso:   #281307;  /* display + painel escuro */

    --musa-ink:        var(--musa-brown);
    --musa-ink-strong: var(--musa-espresso);
    --musa-accent:     var(--musa-bronze);
    --musa-hair:       color-mix(in srgb, var(--musa-bronze) 40%, transparent);
    --musa-on-dark:    #f3e7d3;
    --musa-on-dark-soft:#c9a878;

    --musa-serif: "Playfair Display", "Didot", "Bodoni 72", "Bodoni MT", "Hoefler Text", Georgia, "Times New Roman", serif;
    --musa-sans:  ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;

    --musa-s1: 8px;  --musa-s2: 16px; --musa-s3: 24px; --musa-s4: 32px;
    --musa-s5: 48px; --musa-s6: 64px; --musa-s7: 96px;
    --musa-measure: 62ch;
    --musa-container: 1120px;
  }

  .musa-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--musa-sans);
    font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600;
    text-decoration: none; padding: 14px 26px; border-radius: 2px;
    transition: transform .2s, border-color .2s;
  }
  .musa-btn-primary { background: var(--musa-accent); color: var(--musa-cream); border: 1px solid var(--musa-accent); }
  .musa-btn-primary:hover { transform: translateY(-2px); }
  .musa-btn:focus-visible { outline: 2px solid var(--musa-accent); outline-offset: 3px; }
</style>
